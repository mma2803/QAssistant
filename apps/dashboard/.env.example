# Identity Platform (Firebase Web) config for the dashboard SPA sign-in.
# These are public client config values (safe to ship in the bundle); access is
# still gated by the backend's verified ID token + RLS.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=main-nima
# The GCIP tenant id the user signs into (one GCIP tenant per app tenant). For a
# multi-tenant sign-in, this is selected/typed at the login screen instead.
VITE_FIREBASE_TENANT_ID=

# Backend API base. Empty = same-origin "/api" (use the Vite dev proxy). Set to
# an absolute URL for a non-proxied deploy.
VITE_API_BASE_URL=

# Local Identity Platform emulator (development only). When set, the SDK points
# the Auth client at the emulator instead of the live service.
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# Dev proxy target for `vite` (where the NestJS backend listens).
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
