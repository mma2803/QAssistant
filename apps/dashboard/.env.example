# Self-hosted auth (apps/dashboard/src/lib/auth-client.ts). The tenant is
# selected/typed at the login screen (tenant slug); nothing tenant-specific is
# baked into the build.

# Backend API base. Empty = same-origin "/api" (use the Vite dev proxy, or
# Caddy in prod — the dashboard and API share one origin). Set to an absolute
# URL only for a non-proxied, cross-origin deploy.
VITE_API_BASE_URL=

# Dev proxy target for `vite`. Defaults to the remote VPS deployment; override
# only to run the dev dashboard against a local backend.
VITE_API_PROXY_TARGET=https://135-181-104-90.sslip.io
