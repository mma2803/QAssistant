# Reverse proxy + TLS termination + dashboard static file serving
# (self-hosted VPS migration). SITE_ADDRESS is injected from the server's
# persistent .env (e.g. "135-181-104-90.sslip.io") — a bare hostname (no
# scheme) gets automatic HTTPS via Let's Encrypt. Defaulting to
# "http://localhost" keeps `docker compose up` usable without a real
# hostname (e.g. a quick local smoke test of the prod images).
{$SITE_ADDRESS:http://localhost} {
	encode gzip

	@backend path /api/v1* /health
	handle @backend {
		# Active health checks: a container that's "up" but still connecting
		# its DB pool does not receive live traffic during a deploy swap.
		reverse_proxy api:8080 {
			health_uri /health
			health_interval 10s
			health_timeout 3s
		}
	}

	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# Object storage (MinIO), exposed on the "storage." subdomain of SITE_ADDRESS so
# the browser extension can PUT artifacts (screenshots, DOM chunks) directly to
# presigned URLs. The API mints those URLs with
# S3_PUBLIC_ENDPOINT=https://storage.$SITE_ADDRESS, so the signed host must match
# this vhost. Caddy preserves the Host header and the full path by default, so
# MinIO's SigV4 check (host + path + secret) still passes — do NOT rewrite/strip
# here, or every upload 403s. A bare hostname gets automatic HTTPS; sslip.io
# resolves any "<prefix>.135-181-104-90.sslip.io" to the VPS.
storage.{$SITE_ADDRESS:localhost} {
	reverse_proxy minio:9000

	log {
		output stdout
		format console
	}
}
