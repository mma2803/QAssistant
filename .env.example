# QAssistant environment template. Copy to .env for local dev (docker-compose emulators).
# Never commit a real .env. All secrets in prod come from Secret Manager, not this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# europe-west1 (Belgium) per the contract; configurable.
GCP_REGION=europe-west1
GCP_PROJECT_ID=main-nima
API_PORT=8080

# ---------------------------------------------------------------------------
# Database (Cloud SQL Postgres in prod; local postgres / docker-compose locally)
# ---------------------------------------------------------------------------
# DB_DRIVER selects connectivity:
#   "local"     -> plain pg pool against DB_HOST/DB_PORT (docker-compose, emulators)
#   "cloud-sql" -> @google-cloud/cloud-sql-connector via CLOUD_SQL_INSTANCE
DB_DRIVER=local

# Local / docker-compose postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qassistant
# Runtime app role (RLS-enforced, no BYPASSRLS).
DB_USER=app_user
DB_PASSWORD=app_user_pw
# Privileged super-admin role (BYPASSRLS) used only by the provisioning path.
DB_SUPERADMIN_USER=app_superadmin
DB_SUPERADMIN_PASSWORD=app_superadmin_pw
# Migration owner role (DDL); used by drizzle-kit / migrate only, not at runtime.
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=app_migrator_pw
# Bootstrap superuser for docker-compose container init (creates roles + db).
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=postgres
# In-process pool sizing. Keep small: Cloud SQL max_connections / max instances.
DB_POOL_MAX=10
DB_SSL=false

# Cloud SQL connector (DB_DRIVER=cloud-sql). Keyless via workload identity.
# Format: project:region:instance
CLOUD_SQL_INSTANCE=
# "PUBLIC" or "PRIVATE" IP type for the connector.
CLOUD_SQL_IP_TYPE=PUBLIC

# ---------------------------------------------------------------------------
# Identity Platform / Firebase Admin SDK (GCIP)
# ---------------------------------------------------------------------------
# When set, the Admin SDK talks to the local Firebase Auth emulator instead of
# the live GCIP backend. docker-compose exposes it on 9099.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Project id used by firebase-admin (matches the GCIP / GCP project).
FIREBASE_PROJECT_ID=main-nima
# First super-admin bootstrap (npm run -w @qassistant/api seed:super-admin).
# Used only by the seed script; the super-admin has no tenant (project-level).
SUPER_ADMIN_EMAIL=ops@example.com
SUPER_ADMIN_PASSWORD=change-me-now

# ---------------------------------------------------------------------------
# Google Cloud Storage (artifacts). fake-gcs-server locally.
# ---------------------------------------------------------------------------
ARTIFACTS_BUCKET=qassistant-artifacts-local
# When set, the GCS client + signers target the fake-gcs-server emulator.
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
# V4 signed-url TTL (seconds) for write-only PUT upload URLs.
UPLOAD_URL_TTL_SECONDS=900
# Storage driver: 'local' mints fake signed URLs (offline dev); 'gcs' signs V4.
STORAGE_DRIVER=local
# Base URL of the local upload sink used only by the 'local' storage driver.
LOCAL_UPLOAD_BASE_URL=http://127.0.0.1:4443

# ---------------------------------------------------------------------------
# Secret Manager (Jira tokens, default creds). Stores only refs in the DB.
# ---------------------------------------------------------------------------
# 'local' persists secrets under a temp dir (offline dev); 'gcp' uses the API.
SECRETS_DRIVER=local
# Optional override of the local secrets dir (defaults to os.tmpdir()/qassistant-secrets).
LOCAL_SECRETS_DIR=

# ---------------------------------------------------------------------------
# Jira (read-only validation at session start).
# ---------------------------------------------------------------------------
# 'local' uses an in-memory fixture client; 'http' calls the live Jira REST API.
JIRA_DRIVER=local

# ---------------------------------------------------------------------------
# Internal worker endpoints (inactivity sweep, purge). OIDC-gated in prod;
# this shared token is the local/dev backstop guarding /internal/tasks/*.
# ---------------------------------------------------------------------------
INTERNAL_TASK_TOKEN=local-internal-task-token

# ---------------------------------------------------------------------------
# Gemini Developer API (paid tier). Key comes from Secret Manager in prod.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# ---------------------------------------------------------------------------
# Cloud Tasks (async codegen). Worker endpoint is OIDC-gated in prod.
# ---------------------------------------------------------------------------
CLOUD_TASKS_QUEUE=codegen
CLOUD_TASKS_LOCATION=europe-west1
# Base URL the queue calls back into (this service).
CLOUD_TASKS_TARGET_BASE_URL=http://127.0.0.1:8080
