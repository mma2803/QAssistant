{
  "name": "@qassistant/api",
  "version": "0.1.0",
  "private": true,
  "description": "QAssistant backend API (NestJS + Drizzle + RLS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:http": "npm run build && node --import tsx --test --test-concurrency=1 test/http-e2e.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx ./src/db/migrate.ts",
    "seed:super-admin": "node --import tsx ./src/scripts/seed-super-admin.ts"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.4.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/tasks": "^5.5.0",
    "@google/genai": "^1.0.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@qassistant/shared": "*",
    "drizzle-orm": "^0.36.4",
    "firebase-admin": "^12.7.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
