# QAssistant environment template. Copy to .env for local dev (docker-compose).
# Never commit a real .env. In prod, this file lives ONLY on the VPS
# (/opt/qassistant/.env), generated once during bootstrap, never in git and
# never passed through CI/CD.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=8080

# ---------------------------------------------------------------------------
# Database (self-hosted Postgres — the app's own container in prod)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qassistant
# Runtime app role (RLS-enforced, no BYPASSRLS).
DB_USER=app_user
DB_PASSWORD=app_user_pw
# Privileged super-admin role (BYPASSRLS) used only by the provisioning path.
DB_SUPERADMIN_USER=app_superadmin
DB_SUPERADMIN_PASSWORD=app_superadmin_pw
# Migration owner role (DDL); used by drizzle-kit / migrate only, not at runtime.
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=app_migrator_pw
# Bootstrap superuser for docker-compose container init (creates roles + db).
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=postgres
# In-process pool sizing. Keep small on a memory-constrained VPS; must divide
# evenly into Postgres max_connections (see infra/docker-compose.prod.yml).
DB_POOL_MAX=10
DB_SSL=false

# ---------------------------------------------------------------------------
# Self-hosted auth (opaque bearer tokens; see apps/api/src/auth/token.service.ts)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000
# First super-admin bootstrap (npm run -w @qassistant/api seed:super-admin).
# Used only by the seed script; the super-admin has no tenant (project-level).
SUPER_ADMIN_EMAIL=ops@example.com
SUPER_ADMIN_PASSWORD=change-me-now

# ---------------------------------------------------------------------------
# Secrets (Jira tokens, project default creds). Stores only refs in the DB.
# ---------------------------------------------------------------------------
# 'local' persists secrets under a temp dir, plaintext (offline dev only).
# 'postgres' envelope-encrypts (AES-256-GCM) into the encrypted_secrets table
# using SECRETS_ENCRYPTION_KEY, which never itself touches the database.
SECRETS_DRIVER=local
# Optional override of the local secrets dir (defaults to os.tmpdir()/qassistant-secrets).
LOCAL_SECRETS_DIR=
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Required
# when SECRETS_DRIVER=postgres. Generated once during VPS bootstrap; losing it
# permanently loses the ability to decrypt stored secrets — back it up.
SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Object storage (artifacts). 'local' mints fake signed URLs (offline dev);
# 's3' uses a real S3-compatible endpoint (MinIO in prod).
# ---------------------------------------------------------------------------
ARTIFACTS_BUCKET=qassistant-artifacts-local
# Presigned-URL TTL (seconds) for write-only PUT upload URLs.
UPLOAD_URL_TTL_SECONDS=900
STORAGE_DRIVER=local
# Base URL of the local upload sink used only by the 'local' storage driver.
LOCAL_UPLOAD_BASE_URL=http://127.0.0.1:4443
# S3-compatible endpoint (MinIO). Required when STORAGE_DRIVER=s3.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing (bucket in the URL path, not a subdomain).
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Jira (read-only validation at session start).
# ---------------------------------------------------------------------------
# 'local' uses an in-memory fixture client; 'http' calls the live Jira REST API.
JIRA_DRIVER=local

# ---------------------------------------------------------------------------
# Internal worker endpoints (inactivity sweep, purge) backstop token.
# ---------------------------------------------------------------------------
INTERNAL_TASK_TOKEN=local-internal-task-token

# ---------------------------------------------------------------------------
# Gemini Developer API (paid tier).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest
# Hard timeout so one stuck call can't pin the codegen poller (ms).
GEMINI_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Async codegen queue. 'inline' runs the worker synchronously in-process
# (tests/dev). 'postgres' enqueues to codegen_jobs; an in-process poller
# claims and runs it (no separate worker container or Redis).
# ---------------------------------------------------------------------------
CLOUD_TASKS_DRIVER=inline
